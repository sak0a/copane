{
  "name": "vscode-agent-bridge",
  "displayName": "Agent Bridge: Browser & Terminal for Claude Code",
  "description": "Gives Claude Code (and other MCP agents) first-class access to VS Code's integrated browser tabs and integrated terminals, per window and per agent session.",
  "publisher": "sak0a",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "mcp",
    "browser",
    "terminal",
    "agent",
    "codex"
  ],
  "extensionKind": [
    "workspace"
  ],
  "enabledApiProposals": [
    "browser",
    "terminalDataWriteEvent",
    "terminalDimensions"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentBridge.showLog",
        "title": "Show Log",
        "category": "Agent Bridge"
      },
      {
        "command": "agentBridge.browser.pauseTab",
        "title": "Pause Agent Access to Browser Tab",
        "shortTitle": "Take Over",
        "category": "Agent Bridge",
        "icon": "$(debug-pause)"
      },
      {
        "command": "agentBridge.browser.resumeTab",
        "title": "Resume Agent Access to Browser Tab",
        "shortTitle": "Resume Agent",
        "category": "Agent Bridge",
        "icon": "$(debug-continue)"
      },
      {
        "command": "agentBridge.browser.releaseTab",
        "title": "End Agent Control of Browser Tab",
        "category": "Agent Bridge"
      },
      {
        "command": "agentBridge.browser.revealTab",
        "title": "Show Browser Tab",
        "category": "Agent Bridge"
      },
      {
        "command": "agentBridge.browser.shareTab",
        "title": "Share Browser Tab with Agent Session…",
        "category": "Agent Bridge"
      },
      {
        "command": "agentBridge.browser.resetPermissions",
        "title": "Reset Browser Tab Permissions",
        "category": "Agent Bridge"
      },
      {
        "command": "agentBridge.repair",
        "title": "Check and Repair Setup",
        "category": "Agent Bridge",
        "icon": "$(tools)"
      },
      {
        "command": "agentBridge.registerAgents",
        "title": "Turn On (Register with Claude Code and Codex)",
        "category": "Agent Bridge"
      },
      {
        "command": "agentBridge.unregisterAgents",
        "title": "Turn Off (Unregister from Claude Code and Codex)",
        "category": "Agent Bridge"
      },
      {
        "command": "agentBridge.enableBrowser",
        "title": "Enable Integrated Browser",
        "category": "Agent Bridge"
      },
      {
        "command": "agentBridge.showStatus",
        "title": "Show Status",
        "category": "Agent Bridge"
      },
      {
        "command": "agentBridge.copyStatus",
        "title": "Copy Status Report",
        "category": "Agent Bridge",
        "icon": "$(copy)"
      },
      {
        "command": "agentBridge.terminal.finishRequest",
        "title": "Done: Hand Terminal Back to Agent",
        "category": "Agent Bridge",
        "icon": "$(check)"
      },
      {
        "command": "agentBridge.terminal.declineRequest",
        "title": "Won't Do: Decline Agent's Terminal Request",
        "category": "Agent Bridge",
        "icon": "$(close)"
      },
      {
        "command": "agentBridge.ui.showAttention",
        "title": "Go to What Needs You",
        "category": "Agent Bridge",
        "icon": "$(bell)"
      },
      {
        "command": "agentBridge.ui.revealTab",
        "title": "Show Browser Tab",
        "category": "Agent Bridge",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agentBridge.ui.pauseTab",
        "title": "Pause Agents on Browser Tab",
        "category": "Agent Bridge",
        "icon": "$(debug-pause)"
      },
      {
        "command": "agentBridge.ui.resumeTab",
        "title": "Resume Agents on Browser Tab",
        "category": "Agent Bridge",
        "icon": "$(debug-continue)"
      },
      {
        "command": "agentBridge.ui.releaseTab",
        "title": "Release Browser Tab from Agent",
        "category": "Agent Bridge",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "agentBridge.ui.closeTab",
        "title": "Close Browser Tab",
        "category": "Agent Bridge",
        "icon": "$(close)"
      },
      {
        "command": "agentBridge.ui.revealTerminal",
        "title": "Show Agent Terminal",
        "category": "Agent Bridge",
        "icon": "$(terminal)"
      },
      {
        "command": "agentBridge.ui.interruptTerminal",
        "title": "Interrupt Terminal Command (Ctrl+C)",
        "category": "Agent Bridge",
        "icon": "$(debug-stop)"
      },
      {
        "command": "agentBridge.ui.closeTerminal",
        "title": "Close Agent Terminal",
        "category": "Agent Bridge",
        "icon": "$(trash)"
      },
      {
        "command": "agentBridge.ui.endSession",
        "title": "End Agent Session...",
        "category": "Agent Bridge",
        "icon": "$(close)"
      },
      {
        "command": "agentBridge.ui.pauseSessionTabs",
        "title": "Pause Agent on All Its Tabs",
        "category": "Agent Bridge",
        "icon": "$(debug-pause)"
      },
      {
        "command": "agentBridge.ui.resumeSessionTabs",
        "title": "Resume Agent on All Its Tabs",
        "category": "Agent Bridge",
        "icon": "$(debug-continue)"
      }
    ],
    "configuration": {
      "title": "Agent Bridge",
      "properties": {
        "agentBridge.sessionGraceSeconds": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "How long a disconnected agent session keeps its tabs and terminals before they are released. Lets an agent reconnect after a window reload."
        },
        "agentBridge.browser.userTabs": {
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ],
          "enumDescriptions": [
            "Ask before an agent session reads or controls a browser tab you opened (once per tab, or per site).",
            "Let every agent session use browser tabs you opened without asking.",
            "Never let agent sessions use browser tabs you opened; they work in their own tabs."
          ],
          "default": "ask",
          "description": "Whether agent sessions may use integrated-browser tabs that you opened. Tabs an agent opened itself are always available to it."
        },
        "agentBridge.browser.leaseIdleSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "description": "How long an agent session keeps control of a browser tab without acting in it. After that the tab's indicator disappears and another session may take control."
        },
        "agentBridge.browser.pageIndicator": {
          "type": "boolean",
          "default": true,
          "description": "Show a small indicator in the page (and a thin frame in the session's color) while an agent session controls a browser tab, with a button to take over."
        },
        "agentBridge.browser.certificateErrors": {
          "type": "string",
          "enum": [
            "ask",
            "block"
          ],
          "enumDescriptions": [
            "When an agent session opens a site with an untrusted certificate, ask whether to proceed (once per host). Hosts in the trusted list proceed without asking.",
            "Never proceed past certificate errors for agents. You can still proceed yourself on the browser's error page."
          ],
          "default": "ask",
          "description": "What happens when a browser tab an agent session is driving hits a certificate error (self-signed, company authority, wrong host name)."
        },
        "agentBridge.browser.trustedCertificateHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Hosts whose certificate errors are accepted without asking in tabs an agent session is driving, for local and company servers with self-signed or internally issued certificates. Exact host names (`localhost`, `build.corp.example`) or `*.corp.example` for a domain and all its subdomains. Choosing **Always Trust** in the prompt adds a host here."
        },
        "agentBridge.registration.mode": {
          "type": "string",
          "enum": [
            "ask",
            "automatic",
            "manual"
          ],
          "enumDescriptions": [
            "Ask once before adding the \"vscode\" MCP server to Claude Code's and Codex's user configuration. Afterwards Agent Bridge keeps its own entry present and up to date (it re-adds it if something removes it) until you run \"Agent Bridge: Turn Off\".",
            "Add and keep the \"vscode\" MCP server in Claude Code's and Codex's user configuration without asking.",
            "Never change agent configuration on its own; only report problems. Use \"Agent Bridge: Turn On\", \"Agent Bridge: Turn Off\" and \"Agent Bridge: Check and Repair Setup\"."
          ],
          "default": "ask",
          "scope": "machine",
          "markdownDescription": "How Agent Bridge makes its tools available to agents. It adds an MCP server named `vscode` to the user configuration of Claude Code (`~/.claude.json`) and Codex (`~/.codex/config.toml`), and never changes or removes a `vscode` server it did not add."
        },
        "agentBridge.registration.claudeCode": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Register the `vscode` MCP server with Claude Code (the `claude` CLI and the Claude Code VS Code extension)."
        },
        "agentBridge.registration.codex": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Register the `vscode` MCP server with Codex, when Codex is installed."
        },
        "agentBridge.terminal.userTerminals": {
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ],
          "enumDescriptions": [
            "Ask before an agent session reads or types in a terminal you opened (once per terminal and session).",
            "Agent sessions may read and type in your terminals without asking.",
            "Agent sessions never get access to your terminals (they still see that they exist)."
          ],
          "default": "ask",
          "description": "Whether agent sessions may read and type in terminals you opened yourself."
        },
        "agentBridge.terminal.onSessionEnd": {
          "type": "string",
          "enum": [
            "keep",
            "closeIdle",
            "close"
          ],
          "enumDescriptions": [
            "Keep the session's terminals open, so you can still read them; whatever runs in them keeps running.",
            "Close the session's terminals that are at an idle prompt; keep those still running something (e.g. a dev server).",
            "Close all of the session's terminals, stopping whatever runs in them."
          ],
          "default": "keep",
          "description": "What happens to an agent session's terminals when the session ends (after the reconnect grace period)."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "agentBridge.browser.pauseTab",
          "when": "activeEditor == workbench.editor.browser && agentBridge.browser.activeTabControlled && !agentBridge.browser.activeTabPaused",
          "group": "navigation@-10"
        },
        {
          "command": "agentBridge.browser.resumeTab",
          "when": "activeEditor == workbench.editor.browser && agentBridge.browser.activeTabPaused",
          "group": "navigation@-10"
        },
        {
          "command": "agentBridge.copyStatus",
          "when": "resourceScheme == agent-bridge-status",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "agentBridge.terminal.finishRequest",
          "when": "view == terminal && agentBridge.terminal.waitingForUser",
          "group": "navigation@0"
        },
        {
          "command": "agentBridge.terminal.declineRequest",
          "when": "view == terminal && agentBridge.terminal.waitingForUser",
          "group": "1_agentBridge"
        },
        {
          "command": "agentBridge.showStatus",
          "when": "view == agentBridge.sessions",
          "group": "9_diagnostics@1"
        },
        {
          "command": "agentBridge.showLog",
          "when": "view == agentBridge.sessions",
          "group": "9_diagnostics@2"
        }
      ],
      "commandPalette": [
        {
          "command": "agentBridge.terminal.finishRequest",
          "when": "agentBridge.terminal.waitingForUser"
        },
        {
          "command": "agentBridge.terminal.declineRequest",
          "when": "agentBridge.terminal.waitingForUser"
        },
        {
          "command": "agentBridge.ui.showAttention",
          "when": "agentBridge.ui.hasSessions"
        },
        {
          "command": "agentBridge.ui.revealTab",
          "when": "agentBridge.ui.hasSessions && !agentBridge.ui.browserUnavailable"
        },
        {
          "command": "agentBridge.ui.pauseTab",
          "when": "agentBridge.ui.hasSessions && !agentBridge.ui.browserUnavailable"
        },
        {
          "command": "agentBridge.ui.resumeTab",
          "when": "agentBridge.ui.hasSessions && !agentBridge.ui.browserUnavailable"
        },
        {
          "command": "agentBridge.ui.releaseTab",
          "when": "agentBridge.ui.hasSessions && !agentBridge.ui.browserUnavailable"
        },
        {
          "command": "agentBridge.ui.closeTab",
          "when": "agentBridge.ui.hasSessions && !agentBridge.ui.browserUnavailable"
        },
        {
          "command": "agentBridge.ui.revealTerminal",
          "when": "agentBridge.ui.hasSessions"
        },
        {
          "command": "agentBridge.ui.interruptTerminal",
          "when": "agentBridge.ui.hasSessions"
        },
        {
          "command": "agentBridge.ui.closeTerminal",
          "when": "agentBridge.ui.hasSessions"
        },
        {
          "command": "agentBridge.ui.endSession",
          "when": "agentBridge.ui.hasSessions"
        },
        {
          "command": "agentBridge.ui.pauseSessionTabs",
          "when": "agentBridge.ui.hasSessions && !agentBridge.ui.browserUnavailable"
        },
        {
          "command": "agentBridge.ui.resumeSessionTabs",
          "when": "agentBridge.ui.hasSessions && !agentBridge.ui.browserUnavailable"
        }
      ],
      "view/item/context": [
        {
          "command": "agentBridge.ui.releaseTab",
          "when": "view == agentBridge.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\breleasable\\b/",
          "group": "inline@1"
        },
        {
          "command": "agentBridge.ui.pauseTab",
          "when": "view == agentBridge.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bnotPaused\\b/",
          "group": "inline@2"
        },
        {
          "command": "agentBridge.ui.resumeTab",
          "when": "view == agentBridge.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bpaused\\b/",
          "group": "inline@2"
        },
        {
          "command": "agentBridge.ui.revealTab",
          "when": "view == agentBridge.sessions && viewItem =~ /\\btab\\b/",
          "group": "1_show@1"
        },
        {
          "command": "agentBridge.ui.pauseTab",
          "when": "view == agentBridge.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bnotPaused\\b/",
          "group": "2_control@1"
        },
        {
          "command": "agentBridge.ui.resumeTab",
          "when": "view == agentBridge.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bpaused\\b/",
          "group": "2_control@1"
        },
        {
          "command": "agentBridge.ui.releaseTab",
          "when": "view == agentBridge.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\breleasable\\b/",
          "group": "2_control@2"
        },
        {
          "command": "agentBridge.ui.closeTab",
          "when": "view == agentBridge.sessions && viewItem =~ /\\btab\\b/",
          "group": "3_close@1"
        },
        {
          "command": "agentBridge.ui.interruptTerminal",
          "when": "view == agentBridge.sessions && viewItem =~ /\\bterminal\\b/ && viewItem =~ /\\binterruptible\\b/",
          "group": "inline@1"
        },
        {
          "command": "agentBridge.ui.revealTerminal",
          "when": "view == agentBridge.sessions && viewItem =~ /\\bterminal\\b/ && viewItem =~ /\\bopen\\b/",
          "group": "1_show@1"
        },
        {
          "command": "agentBridge.ui.interruptTerminal",
          "when": "view == agentBridge.sessions && viewItem =~ /\\bterminal\\b/ && viewItem =~ /\\binterruptible\\b/",
          "group": "2_control@1"
        },
        {
          "command": "agentBridge.ui.closeTerminal",
          "when": "view == agentBridge.sessions && viewItem =~ /\\bterminal\\b/ && viewItem =~ /\\bopen\\b/",
          "group": "3_close@1"
        },
        {
          "command": "agentBridge.ui.endSession",
          "when": "view == agentBridge.sessions && viewItem =~ /\\bsession\\b/",
          "group": "inline@9"
        },
        {
          "command": "agentBridge.ui.pauseSessionTabs",
          "when": "view == agentBridge.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /\\bhasUnpausedTabs\\b/",
          "group": "2_control@1"
        },
        {
          "command": "agentBridge.ui.resumeSessionTabs",
          "when": "view == agentBridge.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /\\bhasPausedTabs\\b/",
          "group": "2_control@2"
        },
        {
          "command": "agentBridge.ui.endSession",
          "when": "view == agentBridge.sessions && viewItem =~ /\\bsession\\b/",
          "group": "9_end@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentBridge",
          "title": "Agent Bridge",
          "icon": "media/agent-bridge.svg"
        }
      ]
    },
    "views": {
      "agentBridge": [
        {
          "id": "agentBridge.sessions",
          "name": "Sessions",
          "type": "tree",
          "icon": "media/agent-bridge.svg",
          "contextualTitle": "Agent Bridge"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentBridge.sessions",
        "contents": "No agent is connected to this window yet.\nStart Claude Code in this window, in its panel or by running claude in a terminal. Each session appears here with the browser tabs and terminals it uses, and you can pause it or step in at any time.\n[Set Up Agents](command:agentBridge.registerAgents)\nAlready set up? [Show Status](command:agentBridge.showStatus) explains why nothing is connected."
      },
      {
        "view": "agentBridge.sessions",
        "when": "agentBridge.ui.browserUnavailable",
        "contents": "The integrated browser is not enabled for Agent Bridge, so agents can use terminals but no browser tabs.\n[Enable Integrated Browser](command:agentBridge.enableBrowser)\nVS Code restarts once to turn it on."
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "dev:host": "node scripts/dev-host.mjs",
    "mcp": "node scripts/mcp-call.mjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/headless": "^6.0.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.6.7"
  }
}
