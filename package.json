{
  "name": "copane",
  "displayName": "Copane",
  "description": "Shares your VS Code window with Claude Code and other MCP agents: its integrated browser tabs and terminals, per window and per agent session, with you able to step in.",
  "publisher": "saka",
  "version": "0.1.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "mcp",
    "browser",
    "terminal",
    "agent",
    "codex",
    "ai"
  ],
  "extensionKind": [
    "workspace"
  ],
  "enabledApiProposals": [
    "browser",
    "terminalDataWriteEvent",
    "terminalDimensions"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copane.showLog",
        "title": "Show Log",
        "category": "Copane"
      },
      {
        "command": "copane.browser.pauseTab",
        "title": "Pause Agent Access to Browser Tab",
        "shortTitle": "Take Over",
        "category": "Copane",
        "icon": "$(debug-pause)"
      },
      {
        "command": "copane.browser.resumeTab",
        "title": "Resume Agent Access to Browser Tab",
        "shortTitle": "Resume Agent",
        "category": "Copane",
        "icon": "$(debug-continue)"
      },
      {
        "command": "copane.browser.releaseTab",
        "title": "End Agent Control of Browser Tab",
        "category": "Copane"
      },
      {
        "command": "copane.browser.revealTab",
        "title": "Show Browser Tab",
        "category": "Copane"
      },
      {
        "command": "copane.browser.shareTab",
        "title": "Share Browser Tab with Agent Session…",
        "category": "Copane"
      },
      {
        "command": "copane.browser.resetPermissions",
        "title": "Reset Browser Tab Permissions",
        "category": "Copane"
      },
      {
        "command": "copane.repair",
        "title": "Check and Repair Setup",
        "category": "Copane",
        "icon": "$(tools)"
      },
      {
        "command": "copane.registerAgents",
        "title": "Turn On (Register with Claude Code and Codex)",
        "category": "Copane"
      },
      {
        "command": "copane.unregisterAgents",
        "title": "Turn Off (Unregister from Claude Code and Codex)",
        "category": "Copane"
      },
      {
        "command": "copane.enableBrowser",
        "title": "Enable Integrated Browser",
        "category": "Copane"
      },
      {
        "command": "copane.showStatus",
        "title": "Show Status",
        "category": "Copane"
      },
      {
        "command": "copane.copyStatus",
        "title": "Copy Status Report",
        "category": "Copane",
        "icon": "$(copy)"
      },
      {
        "command": "copane.terminal.finishRequest",
        "title": "Done: Hand Terminal Back to Agent",
        "category": "Copane",
        "icon": "$(check)"
      },
      {
        "command": "copane.terminal.declineRequest",
        "title": "Won't Do: Decline Agent's Terminal Request",
        "category": "Copane",
        "icon": "$(close)"
      },
      {
        "command": "copane.ui.showAttention",
        "title": "Go to What Needs You",
        "category": "Copane",
        "icon": "$(bell)"
      },
      {
        "command": "copane.ui.revealTab",
        "title": "Show Browser Tab",
        "category": "Copane",
        "icon": "$(go-to-file)"
      },
      {
        "command": "copane.ui.pauseTab",
        "title": "Pause Agents on Browser Tab",
        "category": "Copane",
        "icon": "$(debug-pause)"
      },
      {
        "command": "copane.ui.resumeTab",
        "title": "Resume Agents on Browser Tab",
        "category": "Copane",
        "icon": "$(debug-continue)"
      },
      {
        "command": "copane.ui.releaseTab",
        "title": "Release Browser Tab from Agent",
        "category": "Copane",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "copane.ui.closeTab",
        "title": "Close Browser Tab",
        "category": "Copane",
        "icon": "$(close)"
      },
      {
        "command": "copane.ui.revealTerminal",
        "title": "Show Agent Terminal",
        "category": "Copane",
        "icon": "$(terminal)"
      },
      {
        "command": "copane.ui.interruptTerminal",
        "title": "Interrupt Terminal Command (Ctrl+C)",
        "category": "Copane",
        "icon": "$(debug-stop)"
      },
      {
        "command": "copane.ui.closeTerminal",
        "title": "Close Agent Terminal",
        "category": "Copane",
        "icon": "$(trash)"
      },
      {
        "command": "copane.ui.endSession",
        "title": "End Agent Session...",
        "category": "Copane",
        "icon": "$(close)"
      },
      {
        "command": "copane.ui.pauseSessionTabs",
        "title": "Pause Agent on All Its Tabs",
        "category": "Copane",
        "icon": "$(debug-pause)"
      },
      {
        "command": "copane.ui.resumeSessionTabs",
        "title": "Resume Agent on All Its Tabs",
        "category": "Copane",
        "icon": "$(debug-continue)"
      },
      {
        "command": "copane.ui.showSession",
        "title": "Show Agent Session",
        "icon": "$(robot)"
      },
      {
        "command": "copane.ui.showSessionInView",
        "title": "Show Agent Session in Sessions View",
        "icon": "$(list-tree)"
      }
    ],
    "configuration": {
      "title": "Copane",
      "properties": {
        "copane.sessionGraceSeconds": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "description": "How long a disconnected agent session keeps its tabs and terminals before they are released. Lets an agent reconnect after a window reload."
        },
        "copane.browser.userTabs": {
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ],
          "enumDescriptions": [
            "Ask before an agent session reads or controls a browser tab you opened (once per tab, or per site).",
            "Let every agent session use browser tabs you opened without asking.",
            "Never let agent sessions use browser tabs you opened; they work in their own tabs."
          ],
          "default": "ask",
          "description": "Whether agent sessions may use integrated-browser tabs that you opened. Tabs an agent opened itself are always available to it."
        },
        "copane.browser.leaseIdleSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "description": "How long an agent session keeps control of a browser tab without acting in it. After that the tab's indicator disappears and another session may take control."
        },
        "copane.browser.pageIndicator": {
          "type": "boolean",
          "default": true,
          "description": "Show a small indicator in the page (and a thin frame in the session's color) while an agent session controls a browser tab, with a button to take over."
        },
        "copane.browser.certificateErrors": {
          "type": "string",
          "enum": [
            "ask",
            "block"
          ],
          "enumDescriptions": [
            "When an agent session opens a site with an untrusted certificate, ask whether to proceed (once per host). Hosts in the trusted list proceed without asking.",
            "Never proceed past certificate errors for agents. You can still proceed yourself on the browser's error page."
          ],
          "default": "ask",
          "description": "What happens when a browser tab an agent session is driving hits a certificate error (self-signed, company authority, wrong host name)."
        },
        "copane.browser.trustedCertificateHosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Hosts whose certificate errors are accepted without asking in tabs an agent session is driving, for local and company servers with self-signed or internally issued certificates. Exact host names (`localhost`, `build.corp.example`) or `*.corp.example` for a domain and all its subdomains. Choosing **Always Trust** in the prompt adds a host here."
        },
        "copane.registration.mode": {
          "type": "string",
          "enum": [
            "ask",
            "automatic",
            "manual"
          ],
          "enumDescriptions": [
            "Ask once before adding the \"copane\" MCP server to Claude Code's and Codex's user configuration. Afterwards Copane keeps its own entry present and up to date (it re-adds it if something removes it) until you run \"Copane: Turn Off\".",
            "Add and keep the \"copane\" MCP server in Claude Code's and Codex's user configuration without asking.",
            "Never change agent configuration on its own; only report problems. Use \"Copane: Turn On\", \"Copane: Turn Off\" and \"Copane: Check and Repair Setup\"."
          ],
          "default": "ask",
          "scope": "machine",
          "markdownDescription": "How Copane makes its tools available to agents. It adds an MCP server named `copane` to the user configuration of Claude Code (`~/.claude.json`) and Codex (`~/.codex/config.toml`), and never changes or removes a `copane` server it did not add."
        },
        "copane.registration.claudeCode": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Register the `copane` MCP server with Claude Code (the `claude` CLI and the Claude Code VS Code extension)."
        },
        "copane.registration.codex": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Register the `copane` MCP server with Codex, when Codex is installed."
        },
        "copane.terminal.userTerminals": {
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ],
          "enumDescriptions": [
            "Ask before an agent session reads or types in a terminal you opened (once per terminal and session).",
            "Agent sessions may read and type in your terminals without asking.",
            "Agent sessions never get access to your terminals (they still see that they exist)."
          ],
          "default": "ask",
          "description": "Whether agent sessions may read and type in terminals you opened yourself."
        },
        "copane.terminal.onSessionEnd": {
          "type": "string",
          "enum": [
            "keep",
            "closeIdle",
            "close"
          ],
          "enumDescriptions": [
            "Keep the session's terminals open, so you can still read them; whatever runs in them keeps running.",
            "Close the session's terminals that are at an idle prompt; keep those still running something (e.g. a dev server).",
            "Close all of the session's terminals, stopping whatever runs in them."
          ],
          "default": "keep",
          "description": "What happens to an agent session's terminals when the session ends (after the reconnect grace period)."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "copane.browser.pauseTab",
          "when": "activeEditor == workbench.editor.browser && copane.browser.activeTabControlled && !copane.browser.activeTabPaused",
          "group": "navigation@-10"
        },
        {
          "command": "copane.browser.resumeTab",
          "when": "activeEditor == workbench.editor.browser && copane.browser.activeTabPaused",
          "group": "navigation@-10"
        },
        {
          "command": "copane.copyStatus",
          "when": "resourceScheme == copane-status",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "copane.terminal.finishRequest",
          "when": "view == terminal && copane.terminal.waitingForUser",
          "group": "navigation@0"
        },
        {
          "command": "copane.terminal.declineRequest",
          "when": "view == terminal && copane.terminal.waitingForUser",
          "group": "1_copane"
        },
        {
          "command": "copane.registerAgents",
          "when": "view == copane.sessions",
          "group": "8_setup@1"
        },
        {
          "command": "copane.unregisterAgents",
          "when": "view == copane.sessions",
          "group": "8_setup@2"
        },
        {
          "command": "copane.repair",
          "when": "view == copane.sessions",
          "group": "9_diagnostics@0"
        },
        {
          "command": "copane.showStatus",
          "when": "view == copane.sessions",
          "group": "9_diagnostics@1"
        },
        {
          "command": "copane.showLog",
          "when": "view == copane.sessions",
          "group": "9_diagnostics@2"
        }
      ],
      "commandPalette": [
        {
          "command": "copane.terminal.finishRequest",
          "when": "copane.terminal.waitingForUser"
        },
        {
          "command": "copane.terminal.declineRequest",
          "when": "copane.terminal.waitingForUser"
        },
        {
          "command": "copane.ui.showAttention",
          "when": "copane.ui.hasSessions"
        },
        {
          "command": "copane.ui.revealTab",
          "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable"
        },
        {
          "command": "copane.ui.pauseTab",
          "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable"
        },
        {
          "command": "copane.ui.resumeTab",
          "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable"
        },
        {
          "command": "copane.ui.releaseTab",
          "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable"
        },
        {
          "command": "copane.ui.closeTab",
          "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable"
        },
        {
          "command": "copane.ui.revealTerminal",
          "when": "copane.ui.hasSessions"
        },
        {
          "command": "copane.ui.interruptTerminal",
          "when": "copane.ui.hasSessions"
        },
        {
          "command": "copane.ui.closeTerminal",
          "when": "copane.ui.hasSessions"
        },
        {
          "command": "copane.ui.endSession",
          "when": "copane.ui.hasSessions"
        },
        {
          "command": "copane.ui.pauseSessionTabs",
          "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable"
        },
        {
          "command": "copane.ui.resumeSessionTabs",
          "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable"
        },
        {
          "command": "copane.ui.showSession",
          "when": "copane.ui.hasSessions"
        },
        {
          "command": "copane.ui.showSessionInView",
          "when": "copane.ui.hasSessions"
        }
      ],
      "view/item/context": [
        {
          "command": "copane.ui.releaseTab",
          "when": "view == copane.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\breleasable\\b/",
          "group": "inline@1"
        },
        {
          "command": "copane.ui.pauseTab",
          "when": "view == copane.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bnotPaused\\b/",
          "group": "inline@2"
        },
        {
          "command": "copane.ui.resumeTab",
          "when": "view == copane.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bpaused\\b/",
          "group": "inline@2"
        },
        {
          "command": "copane.ui.revealTab",
          "when": "view == copane.sessions && viewItem =~ /\\btab\\b/",
          "group": "1_show@1"
        },
        {
          "command": "copane.ui.pauseTab",
          "when": "view == copane.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bnotPaused\\b/",
          "group": "2_control@1"
        },
        {
          "command": "copane.ui.resumeTab",
          "when": "view == copane.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bpaused\\b/",
          "group": "2_control@1"
        },
        {
          "command": "copane.ui.releaseTab",
          "when": "view == copane.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\breleasable\\b/",
          "group": "2_control@2"
        },
        {
          "command": "copane.ui.closeTab",
          "when": "view == copane.sessions && viewItem =~ /\\btab\\b/",
          "group": "3_close@1"
        },
        {
          "command": "copane.ui.interruptTerminal",
          "when": "view == copane.sessions && viewItem =~ /\\bterminal\\b/ && viewItem =~ /\\binterruptible\\b/",
          "group": "inline@1"
        },
        {
          "command": "copane.ui.revealTerminal",
          "when": "view == copane.sessions && viewItem =~ /\\bterminal\\b/ && viewItem =~ /\\bopen\\b/",
          "group": "1_show@1"
        },
        {
          "command": "copane.ui.interruptTerminal",
          "when": "view == copane.sessions && viewItem =~ /\\bterminal\\b/ && viewItem =~ /\\binterruptible\\b/",
          "group": "2_control@1"
        },
        {
          "command": "copane.ui.closeTerminal",
          "when": "view == copane.sessions && viewItem =~ /\\bterminal\\b/ && viewItem =~ /\\bopen\\b/",
          "group": "3_close@1"
        },
        {
          "command": "copane.ui.endSession",
          "when": "view == copane.sessions && viewItem =~ /\\bsession\\b/",
          "group": "inline@9"
        },
        {
          "command": "copane.ui.pauseSessionTabs",
          "when": "view == copane.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /\\bhasUnpausedTabs\\b/",
          "group": "2_control@1"
        },
        {
          "command": "copane.ui.resumeSessionTabs",
          "when": "view == copane.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /\\bhasPausedTabs\\b/",
          "group": "2_control@2"
        },
        {
          "command": "copane.ui.endSession",
          "when": "view == copane.sessions && viewItem =~ /\\bsession\\b/",
          "group": "9_end@1"
        },
        {
          "command": "copane.ui.showSession",
          "when": "view == copane.tabs && viewItem =~ /\\btab\\b/",
          "group": "inline@1"
        },
        {
          "command": "copane.ui.pauseTab",
          "when": "view == copane.tabs && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bnotPaused\\b/",
          "group": "inline@2"
        },
        {
          "command": "copane.ui.resumeTab",
          "when": "view == copane.tabs && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bpaused\\b/",
          "group": "inline@2"
        },
        {
          "command": "copane.ui.releaseTab",
          "when": "view == copane.tabs && viewItem =~ /\\btab\\b/ && viewItem =~ /\\breleasable\\b/",
          "group": "inline@3"
        },
        {
          "command": "copane.ui.closeTab",
          "when": "view == copane.tabs && viewItem =~ /\\btab\\b/",
          "group": "inline@4"
        },
        {
          "command": "copane.ui.revealTab",
          "when": "view == copane.tabs && viewItem =~ /\\btab\\b/",
          "group": "1_show@1"
        },
        {
          "command": "copane.ui.showSession",
          "when": "view == copane.tabs && viewItem =~ /\\btab\\b/",
          "group": "1_show@2"
        },
        {
          "command": "copane.ui.showSessionInView",
          "when": "view == copane.tabs && viewItem =~ /\\btab\\b/",
          "group": "1_show@3"
        },
        {
          "command": "copane.ui.pauseTab",
          "when": "view == copane.tabs && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bnotPaused\\b/",
          "group": "2_control@1"
        },
        {
          "command": "copane.ui.resumeTab",
          "when": "view == copane.tabs && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bpaused\\b/",
          "group": "2_control@1"
        },
        {
          "command": "copane.ui.releaseTab",
          "when": "view == copane.tabs && viewItem =~ /\\btab\\b/ && viewItem =~ /\\breleasable\\b/",
          "group": "2_control@2"
        },
        {
          "command": "copane.ui.closeTab",
          "when": "view == copane.tabs && viewItem =~ /\\btab\\b/",
          "group": "3_close@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copane",
          "title": "Copane",
          "icon": "media/copane.svg"
        }
      ],
      "panel": [
        {
          "id": "copaneTabs",
          "title": "Agent Tabs",
          "icon": "media/agent-tabs.svg"
        }
      ]
    },
    "views": {
      "copane": [
        {
          "id": "copane.sessions",
          "name": "Sessions",
          "type": "tree",
          "icon": "media/copane.svg",
          "contextualTitle": "Copane"
        }
      ],
      "copaneTabs": [
        {
          "id": "copane.tabs",
          "name": "Agent Tabs",
          "type": "tree",
          "icon": "media/agent-tabs.svg",
          "contextualTitle": "Agent Tabs"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "copane.sessions",
        "contents": "No agent is connected to this window yet.\nStart Claude Code in this window, in its panel or by running claude in a terminal. Each session appears here with the browser tabs and terminals it uses, and you can pause it or step in at any time.\n[Set Up Agents](command:copane.registerAgents)\nAlready set up? [Show Status](command:copane.showStatus) explains why nothing is connected."
      },
      {
        "view": "copane.sessions",
        "when": "copane.ui.browserUnavailable",
        "contents": "The integrated browser is not enabled for Copane, so agents can use terminals but no browser tabs.\n[Enable Integrated Browser](command:copane.enableBrowser)\nVS Code restarts once to turn it on."
      },
      {
        "view": "copane.tabs",
        "when": "!copane.ui.browserUnavailable",
        "contents": "No agent session is using a browser tab in this window.\nTabs that agents open or control are listed here in the color of their session. Click one to bring it to the front."
      },
      {
        "view": "copane.tabs",
        "when": "copane.ui.browserUnavailable",
        "contents": "The integrated browser is not enabled, so agents cannot open or use browser tabs.\n[Enable Integrated Browser](command:copane.enableBrowser)"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "dev:host": "node scripts/dev-host.mjs",
    "mcp": "node scripts/mcp-call.mjs",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/headless": "^6.0.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.6.7"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sak0a/copane.git"
  },
  "bugs": {
    "url": "https://github.com/sak0a/copane/issues"
  },
  "homepage": "https://github.com/sak0a/copane#readme"
}
