{
  "configuration": {
    "title": "Copane",
    "properties": {
      "copane.ui.favicons": {
        "type": "boolean",
        "default": true,
        "markdownDescription": "Show each site's icon on its browser tab rows in the Sessions and Agent Tabs views, instead of a generic globe or state icon. The icon is the one VS Code's browser already shows on the editor tab; Copane loads nothing for it. Icons over 32 KB, in other formats, or SVGs with scripts or outside references are not shown."
      },
      "copane.ui.collapsedTabSizing": {
        "type": "string",
        "enum": ["ask", "compact", "keep"],
        "enumDescriptions": [
          "The first time you collapse a session's tabs while pinned tabs are not compact, ask whether to make them compact.",
          "When collapsing a session's tabs, set `#workbench.editor.pinnedTabSizing#` to `compact` in your user settings if it is not.",
          "Never change `#workbench.editor.pinnedTabSizing#`: collapsed tabs keep the size pinned tabs have."
        ],
        "default": "ask",
        "markdownDescription": "Copane collapses an agent session's browser tabs by pinning them at the left of the tab bar. They take little room only when `#workbench.editor.pinnedTabSizing#` is `compact`, a setting that applies to all pinned tabs in VS Code, your own too. Whether Copane may set it."
      }
    }
  },
  "viewsContainers": {
    "activitybar": [
      { "id": "copane", "title": "Copane", "icon": "media/copane.svg" }
    ],
    "panel": [
      { "id": "copaneTabs", "title": "Agent Tabs", "icon": "media/agent-tabs.svg" }
    ]
  },
  "views": {
    "copane": [
      {
        "id": "copane.sessions",
        "name": "Sessions",
        "type": "tree",
        "icon": "media/copane.svg",
        "contextualTitle": "Copane"
      }
    ],
    "copaneTabs": [
      {
        "id": "copane.tabs",
        "name": "Agent Tabs",
        "type": "tree",
        "icon": "media/agent-tabs.svg",
        "contextualTitle": "Agent Tabs"
      }
    ]
  },
  "viewsWelcome": [
    {
      "view": "copane.sessions",
      "contents": "No agent is connected to this window yet.\nStart Claude Code, Codex or GitHub Copilot in this window, in its chat or in a terminal. Each session appears here with the browser tabs and terminals it uses, and you can pause it or step in at any time."
    },
    {
      "view": "copane.sessions",
      "when": "!copane.setup.agentsReady",
      "contents": "[Get Started](command:copane.openWalkthrough)\nTwo one-time steps: let agents use the integrated browser, and turn Copane on for Claude Code, Codex and GitHub Copilot."
    },
    {
      "view": "copane.sessions",
      "when": "copane.setup.agentsReady",
      "contents": "Already set up? [Show Status](command:copane.showStatus) explains why nothing is connected."
    },
    {
      "view": "copane.sessions",
      "when": "copane.ui.browserUnavailable && copane.setup.agentsReady && copane.setup.browser != 'unsupported'",
      "contents": "The integrated browser is not enabled for Copane, so agents can use terminals but no browser tabs.\n[Enable Integrated Browser](command:copane.enableBrowser)\nVS Code restarts once to turn it on."
    },
    {
      "view": "copane.sessions",
      "when": "copane.setup.browser == 'unsupported'",
      "contents": "This editor has no integrated browser that extensions can drive, so agents get the terminal tools here but no browser tabs."
    },
    {
      "view": "copane.tabs",
      "when": "!copane.ui.browserUnavailable",
      "contents": "No agent session is using a browser tab in this window.\nTabs that agents open or control are listed here in the color of their session. Click one to bring it to the front."
    },
    {
      "view": "copane.tabs",
      "when": "copane.ui.browserUnavailable && copane.setup.browser != 'unsupported'",
      "contents": "The integrated browser is not enabled, so agents cannot open or use browser tabs.\n[Enable Integrated Browser](command:copane.enableBrowser)"
    },
    {
      "view": "copane.tabs",
      "when": "copane.setup.browser == 'unsupported'",
      "contents": "This editor has no integrated browser that extensions can drive, so agents cannot open or use browser tabs here. Their terminals are in the Copane view."
    }
  ],
  "commands": [
    { "command": "copane.ui.showAttention", "title": "Go to What Needs You", "category": "Copane", "icon": "$(bell)" },
    { "command": "copane.ui.revealTab", "title": "Show Browser Tab", "category": "Copane", "icon": "$(go-to-file)" },
    { "command": "copane.ui.pauseTab", "title": "Pause Agents on Browser Tab", "category": "Copane", "icon": "$(debug-pause)" },
    { "command": "copane.ui.resumeTab", "title": "Resume Agents on Browser Tab", "category": "Copane", "icon": "$(debug-continue)" },
    { "command": "copane.ui.releaseTab", "title": "Release Browser Tab from Agent", "category": "Copane", "icon": "$(debug-disconnect)" },
    { "command": "copane.ui.closeTab", "title": "Close Browser Tab", "category": "Copane", "icon": "$(close)" },
    { "command": "copane.ui.revealTerminal", "title": "Show Agent Terminal", "category": "Copane", "icon": "$(terminal)" },
    { "command": "copane.ui.interruptTerminal", "title": "Interrupt Terminal Command (Ctrl+C)", "category": "Copane", "icon": "$(debug-stop)" },
    { "command": "copane.ui.closeTerminal", "title": "Close Agent Terminal", "category": "Copane", "icon": "$(trash)" },
    { "command": "copane.ui.endSession", "title": "End Agent Session...", "category": "Copane", "icon": "$(close)" },
    { "command": "copane.ui.pauseSessionTabs", "title": "Pause Agent on All Its Tabs", "category": "Copane", "icon": "$(debug-pause)" },
    { "command": "copane.ui.resumeSessionTabs", "title": "Resume Agent on All Its Tabs", "category": "Copane", "icon": "$(debug-continue)" },
    { "command": "copane.ui.showSession", "title": "Show Agent Session", "icon": "$(robot)" },
    { "command": "copane.ui.showSessionInView", "title": "Show Agent Session in Sessions View", "icon": "$(list-tree)" },
    { "command": "copane.ui.collapseSessionTabs", "title": "Collapse Agent Session's Browser Tabs", "category": "Copane", "icon": "$(fold)" },
    { "command": "copane.ui.expandSessionTabs", "title": "Expand Agent Session's Browser Tabs", "category": "Copane", "icon": "$(unfold)" },
    { "command": "copane.ui.collapseOtherSessions", "title": "Show Only This Agent Session's Browser Tabs", "category": "Copane", "icon": "$(filter)" },
    { "command": "copane.ui.expandAllSessions", "title": "Expand All Agent Sessions' Browser Tabs", "category": "Copane", "icon": "$(unfold)" },
    { "command": "copane.ui.groupTabsBySession", "title": "Group Browser Tabs by Agent Session", "category": "Copane", "icon": "$(group-by-ref-type)" }
  ],
  "menus": {
    "commandPalette": [
      { "command": "copane.ui.showAttention", "when": "copane.ui.hasSessions" },
      { "command": "copane.ui.revealTab", "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable" },
      { "command": "copane.ui.pauseTab", "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable" },
      { "command": "copane.ui.resumeTab", "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable" },
      { "command": "copane.ui.releaseTab", "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable" },
      { "command": "copane.ui.closeTab", "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable" },
      { "command": "copane.ui.revealTerminal", "when": "copane.ui.hasSessions" },
      { "command": "copane.ui.interruptTerminal", "when": "copane.ui.hasSessions" },
      { "command": "copane.ui.closeTerminal", "when": "copane.ui.hasSessions" },
      { "command": "copane.ui.endSession", "when": "copane.ui.hasSessions" },
      { "command": "copane.ui.pauseSessionTabs", "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable" },
      { "command": "copane.ui.resumeSessionTabs", "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable" },
      { "command": "copane.ui.showSession", "when": "copane.ui.hasSessions" },
      { "command": "copane.ui.showSessionInView", "when": "copane.ui.hasSessions" },
      { "command": "copane.ui.collapseSessionTabs", "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable" },
      { "command": "copane.ui.expandSessionTabs", "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable" },
      { "command": "copane.ui.collapseOtherSessions", "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable" },
      { "command": "copane.ui.expandAllSessions", "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable" },
      { "command": "copane.ui.groupTabsBySession", "when": "copane.ui.hasSessions && !copane.ui.browserUnavailable" }
    ],
    "editor/title/context": [
      { "command": "copane.ui.collapseSessionTabs", "when": "resourceScheme == vscode-browser && resourceFilename in copane.ui.collapsibleTabs", "group": "copane@1" },
      { "command": "copane.ui.expandSessionTabs", "when": "resourceScheme == vscode-browser && resourceFilename in copane.ui.collapsedTabs", "group": "copane@1" },
      { "command": "copane.ui.collapseOtherSessions", "when": "resourceScheme == vscode-browser && resourceFilename in copane.ui.collapsibleTabs", "group": "copane@2" },
      { "command": "copane.ui.collapseOtherSessions", "when": "resourceScheme == vscode-browser && resourceFilename in copane.ui.collapsedTabs", "group": "copane@2" }
    ],
    "view/title": [
      { "command": "copane.ui.groupTabsBySession", "when": "view == copane.sessions && copane.ui.hasSessions && !copane.ui.browserUnavailable", "group": "3_tabs@1" },
      { "command": "copane.ui.expandAllSessions", "when": "view == copane.sessions && copane.ui.hasSessions && !copane.ui.browserUnavailable", "group": "3_tabs@2" },
      { "command": "copane.registerAgents", "when": "view == copane.sessions", "group": "8_setup@1" },
      { "command": "copane.unregisterAgents", "when": "view == copane.sessions", "group": "8_setup@2" },
      { "command": "copane.repair", "when": "view == copane.sessions", "group": "9_diagnostics@0" },
      { "command": "copane.showStatus", "when": "view == copane.sessions", "group": "9_diagnostics@1" },
      { "command": "copane.showLog", "when": "view == copane.sessions", "group": "9_diagnostics@2" }
    ],
    "view/item/context": [
      { "command": "copane.ui.releaseTab", "when": "view == copane.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\breleasable\\b/", "group": "inline@1" },
      { "command": "copane.ui.pauseTab", "when": "view == copane.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bnotPaused\\b/", "group": "inline@2" },
      { "command": "copane.ui.resumeTab", "when": "view == copane.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bpaused\\b/", "group": "inline@2" },
      { "command": "copane.ui.revealTab", "when": "view == copane.sessions && viewItem =~ /\\btab\\b/", "group": "1_show@1" },
      { "command": "copane.ui.pauseTab", "when": "view == copane.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bnotPaused\\b/", "group": "2_control@1" },
      { "command": "copane.ui.resumeTab", "when": "view == copane.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bpaused\\b/", "group": "2_control@1" },
      { "command": "copane.ui.releaseTab", "when": "view == copane.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\breleasable\\b/", "group": "2_control@2" },
      { "command": "copane.ui.closeTab", "when": "view == copane.sessions && viewItem =~ /\\btab\\b/", "group": "3_close@1" },

      { "command": "copane.ui.interruptTerminal", "when": "view == copane.sessions && viewItem =~ /\\bterminal\\b/ && viewItem =~ /\\binterruptible\\b/", "group": "inline@1" },
      { "command": "copane.ui.revealTerminal", "when": "view == copane.sessions && viewItem =~ /\\bterminal\\b/ && viewItem =~ /\\bopen\\b/", "group": "1_show@1" },
      { "command": "copane.ui.interruptTerminal", "when": "view == copane.sessions && viewItem =~ /\\bterminal\\b/ && viewItem =~ /\\binterruptible\\b/", "group": "2_control@1" },
      { "command": "copane.ui.closeTerminal", "when": "view == copane.sessions && viewItem =~ /\\bterminal\\b/ && viewItem =~ /\\bopen\\b/", "group": "3_close@1" },

      { "command": "copane.ui.collapseSessionTabs", "when": "view == copane.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /\\bcollapsible\\b/", "group": "inline@8" },
      { "command": "copane.ui.expandSessionTabs", "when": "view == copane.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /\\bcollapsed\\b/", "group": "inline@8" },
      { "command": "copane.ui.endSession", "when": "view == copane.sessions && viewItem =~ /\\bsession\\b/", "group": "inline@9" },
      { "command": "copane.ui.pauseSessionTabs", "when": "view == copane.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /\\bhasUnpausedTabs\\b/", "group": "2_control@1" },
      { "command": "copane.ui.resumeSessionTabs", "when": "view == copane.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /\\bhasPausedTabs\\b/", "group": "2_control@2" },
      { "command": "copane.ui.collapseSessionTabs", "when": "view == copane.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /\\bcollapsible\\b/", "group": "3_tabs@1" },
      { "command": "copane.ui.expandSessionTabs", "when": "view == copane.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /\\bcollapsed\\b/", "group": "3_tabs@1" },
      { "command": "copane.ui.collapseOtherSessions", "when": "view == copane.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /\\b(collapsible|collapsed)\\b/", "group": "3_tabs@2" },
      { "command": "copane.ui.endSession", "when": "view == copane.sessions && viewItem =~ /\\bsession\\b/", "group": "9_end@1" },

      { "command": "copane.ui.showSession", "when": "view == copane.tabs && viewItem =~ /\\btab\\b/", "group": "inline@1" },
      { "command": "copane.ui.pauseTab", "when": "view == copane.tabs && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bnotPaused\\b/", "group": "inline@2" },
      { "command": "copane.ui.resumeTab", "when": "view == copane.tabs && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bpaused\\b/", "group": "inline@2" },
      { "command": "copane.ui.releaseTab", "when": "view == copane.tabs && viewItem =~ /\\btab\\b/ && viewItem =~ /\\breleasable\\b/", "group": "inline@3" },
      { "command": "copane.ui.closeTab", "when": "view == copane.tabs && viewItem =~ /\\btab\\b/", "group": "inline@4" },
      { "command": "copane.ui.revealTab", "when": "view == copane.tabs && viewItem =~ /\\btab\\b/", "group": "1_show@1" },
      { "command": "copane.ui.showSession", "when": "view == copane.tabs && viewItem =~ /\\btab\\b/", "group": "1_show@2" },
      { "command": "copane.ui.showSessionInView", "when": "view == copane.tabs && viewItem =~ /\\btab\\b/", "group": "1_show@3" },
      { "command": "copane.ui.pauseTab", "when": "view == copane.tabs && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bnotPaused\\b/", "group": "2_control@1" },
      { "command": "copane.ui.resumeTab", "when": "view == copane.tabs && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bpaused\\b/", "group": "2_control@1" },
      { "command": "copane.ui.releaseTab", "when": "view == copane.tabs && viewItem =~ /\\btab\\b/ && viewItem =~ /\\breleasable\\b/", "group": "2_control@2" },
      { "command": "copane.ui.closeTab", "when": "view == copane.tabs && viewItem =~ /\\btab\\b/", "group": "3_close@1" }
    ]
  }
}
