{
  "viewsContainers": {
    "activitybar": [
      { "id": "agentBridge", "title": "Agent Bridge", "icon": "media/agent-bridge.svg" }
    ]
  },
  "views": {
    "agentBridge": [
      {
        "id": "agentBridge.sessions",
        "name": "Sessions",
        "type": "tree",
        "icon": "media/agent-bridge.svg",
        "contextualTitle": "Agent Bridge"
      }
    ]
  },
  "viewsWelcome": [
    {
      "view": "agentBridge.sessions",
      "contents": "No agent is connected to this window yet.\nStart Claude Code in this window, in its panel or by running claude in a terminal. Each session appears here with the browser tabs and terminals it uses, and you can pause it or step in at any time.\n[Set Up Agents](command:agentBridge.registerAgents)\nAlready set up? [Show Status](command:agentBridge.showStatus) explains why nothing is connected."
    },
    {
      "view": "agentBridge.sessions",
      "when": "agentBridge.ui.browserUnavailable",
      "contents": "The integrated browser is not enabled for Agent Bridge, so agents can use terminals but no browser tabs.\n[Enable Integrated Browser](command:agentBridge.enableBrowser)\nVS Code restarts once to turn it on."
    }
  ],
  "commands": [
    { "command": "agentBridge.ui.showAttention", "title": "Go to What Needs You", "category": "Agent Bridge", "icon": "$(bell)" },
    { "command": "agentBridge.ui.revealTab", "title": "Show Browser Tab", "category": "Agent Bridge", "icon": "$(go-to-file)" },
    { "command": "agentBridge.ui.pauseTab", "title": "Pause Agents on Browser Tab", "category": "Agent Bridge", "icon": "$(debug-pause)" },
    { "command": "agentBridge.ui.resumeTab", "title": "Resume Agents on Browser Tab", "category": "Agent Bridge", "icon": "$(debug-continue)" },
    { "command": "agentBridge.ui.releaseTab", "title": "Release Browser Tab from Agent", "category": "Agent Bridge", "icon": "$(debug-disconnect)" },
    { "command": "agentBridge.ui.closeTab", "title": "Close Browser Tab", "category": "Agent Bridge", "icon": "$(close)" },
    { "command": "agentBridge.ui.revealTerminal", "title": "Show Agent Terminal", "category": "Agent Bridge", "icon": "$(terminal)" },
    { "command": "agentBridge.ui.interruptTerminal", "title": "Interrupt Terminal Command (Ctrl+C)", "category": "Agent Bridge", "icon": "$(debug-stop)" },
    { "command": "agentBridge.ui.closeTerminal", "title": "Close Agent Terminal", "category": "Agent Bridge", "icon": "$(trash)" },
    { "command": "agentBridge.ui.endSession", "title": "End Agent Session...", "category": "Agent Bridge", "icon": "$(close)" },
    { "command": "agentBridge.ui.pauseSessionTabs", "title": "Pause Agent on All Its Tabs", "category": "Agent Bridge", "icon": "$(debug-pause)" },
    { "command": "agentBridge.ui.resumeSessionTabs", "title": "Resume Agent on All Its Tabs", "category": "Agent Bridge", "icon": "$(debug-continue)" }
  ],
  "menus": {
    "commandPalette": [
      { "command": "agentBridge.ui.showAttention", "when": "agentBridge.ui.hasSessions" },
      { "command": "agentBridge.ui.revealTab", "when": "agentBridge.ui.hasSessions && !agentBridge.ui.browserUnavailable" },
      { "command": "agentBridge.ui.pauseTab", "when": "agentBridge.ui.hasSessions && !agentBridge.ui.browserUnavailable" },
      { "command": "agentBridge.ui.resumeTab", "when": "agentBridge.ui.hasSessions && !agentBridge.ui.browserUnavailable" },
      { "command": "agentBridge.ui.releaseTab", "when": "agentBridge.ui.hasSessions && !agentBridge.ui.browserUnavailable" },
      { "command": "agentBridge.ui.closeTab", "when": "agentBridge.ui.hasSessions && !agentBridge.ui.browserUnavailable" },
      { "command": "agentBridge.ui.revealTerminal", "when": "agentBridge.ui.hasSessions" },
      { "command": "agentBridge.ui.interruptTerminal", "when": "agentBridge.ui.hasSessions" },
      { "command": "agentBridge.ui.closeTerminal", "when": "agentBridge.ui.hasSessions" },
      { "command": "agentBridge.ui.endSession", "when": "agentBridge.ui.hasSessions" },
      { "command": "agentBridge.ui.pauseSessionTabs", "when": "agentBridge.ui.hasSessions && !agentBridge.ui.browserUnavailable" },
      { "command": "agentBridge.ui.resumeSessionTabs", "when": "agentBridge.ui.hasSessions && !agentBridge.ui.browserUnavailable" }
    ],
    "view/title": [
      { "command": "agentBridge.showLog", "when": "view == agentBridge.sessions", "group": "9_diagnostics@2" }
    ],
    "view/item/context": [
      { "command": "agentBridge.ui.releaseTab", "when": "view == agentBridge.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\breleasable\\b/", "group": "inline@1" },
      { "command": "agentBridge.ui.pauseTab", "when": "view == agentBridge.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bnotPaused\\b/", "group": "inline@2" },
      { "command": "agentBridge.ui.resumeTab", "when": "view == agentBridge.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bpaused\\b/", "group": "inline@2" },
      { "command": "agentBridge.ui.revealTab", "when": "view == agentBridge.sessions && viewItem =~ /\\btab\\b/", "group": "1_show@1" },
      { "command": "agentBridge.ui.pauseTab", "when": "view == agentBridge.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bnotPaused\\b/", "group": "2_control@1" },
      { "command": "agentBridge.ui.resumeTab", "when": "view == agentBridge.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\bpaused\\b/", "group": "2_control@1" },
      { "command": "agentBridge.ui.releaseTab", "when": "view == agentBridge.sessions && viewItem =~ /\\btab\\b/ && viewItem =~ /\\breleasable\\b/", "group": "2_control@2" },
      { "command": "agentBridge.ui.closeTab", "when": "view == agentBridge.sessions && viewItem =~ /\\btab\\b/", "group": "3_close@1" },

      { "command": "agentBridge.ui.interruptTerminal", "when": "view == agentBridge.sessions && viewItem =~ /\\bterminal\\b/ && viewItem =~ /\\binterruptible\\b/", "group": "inline@1" },
      { "command": "agentBridge.ui.revealTerminal", "when": "view == agentBridge.sessions && viewItem =~ /\\bterminal\\b/ && viewItem =~ /\\bopen\\b/", "group": "1_show@1" },
      { "command": "agentBridge.ui.interruptTerminal", "when": "view == agentBridge.sessions && viewItem =~ /\\bterminal\\b/ && viewItem =~ /\\binterruptible\\b/", "group": "2_control@1" },
      { "command": "agentBridge.ui.closeTerminal", "when": "view == agentBridge.sessions && viewItem =~ /\\bterminal\\b/ && viewItem =~ /\\bopen\\b/", "group": "3_close@1" },

      { "command": "agentBridge.ui.endSession", "when": "view == agentBridge.sessions && viewItem =~ /\\bsession\\b/", "group": "inline@9" },
      { "command": "agentBridge.ui.pauseSessionTabs", "when": "view == agentBridge.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /\\bhasUnpausedTabs\\b/", "group": "2_control@1" },
      { "command": "agentBridge.ui.resumeSessionTabs", "when": "view == agentBridge.sessions && viewItem =~ /\\bsession\\b/ && viewItem =~ /\\bhasPausedTabs\\b/", "group": "2_control@2" },
      { "command": "agentBridge.ui.endSession", "when": "view == agentBridge.sessions && viewItem =~ /\\bsession\\b/", "group": "9_end@1" }
    ]
  }
}
